# Copy this file to .env and paste the direct PostgreSQL connection string
# returned by Prisma Postgres (npx create-db).
DATABASE_URL="postgres://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DATABASE?sslmode=require"

# Seed/admin identity. This is only seed metadata for the initial admin record.
ADMIN_NAME="Adewale Matthew"
ADMIN_EMAIL="admin@example.com"
