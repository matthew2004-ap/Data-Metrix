# Required: PostgreSQL connection string.
DATABASE_URL="postgres://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DATABASE?sslmode=require"

# Required for NextAuth sessions. Generate a long random value for production.
AUTH_SECRET="replace-with-a-long-random-secret"

# Used only when running the seed command.
ADMIN_NAME="Adewale Matthew"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-before-seeding"
